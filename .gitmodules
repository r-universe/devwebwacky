[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "rgrind"]
	path = rgrind
	url = https://github.com/devwebwacky/rgrind
[submodule "statease"]
	path = statease
	url = https://github.com/devwebwacky/statease
[submodule "triageR"]
	path = triageR
	url = https://github.com/devwebwacky/triager
